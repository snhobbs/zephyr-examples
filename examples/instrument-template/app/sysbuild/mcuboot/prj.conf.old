#######################
# USB Configuration 
#######################

CONFIG_CDC_ACM_SERIAL_INITIALIZE_AT_BOOT=y
 # Raspberry Pi
CONFIG_USB_DEVICE_VID=0x2E8A
CONFIG_USB_DEVICE_PID=0x0009
#CONFIG_USB_DEVICE_DFU_PID
#CONFIG_USB_DEVICE_SN

# Raspberry Pi
#CONFIG_CDC_ACM_SERIAL_VID=0x2E8A
 # Raspberry Pi Pico SDK CDC UART
#CONFIG_CDC_ACM_SERIAL_PID=0x0009
#CONFIG_CDC_ACM_SERIAL_PID=0x0004
#CONFIG_CDC_ACM_SERIAL_PRODUCT_STRING="CDC UART"
CONFIG_USB_DEVICE_PRODUCT="SMP Bootloader"
CONFIG_USB_DEVICE_MANUFACTURER="Maskset"
CONFIG_USB_DEVICE_STACK=y
CONFIG_USB_DEVICE_INITIALIZE_AT_BOOT=y
#CONFIG_USB_DEVICE_STACK_NEXT=y

#CONFIG_USB_CDC_ACM_LOG_LEVEL_OFF=y

#CONFIG_USBC_TCPC_DRIVER=y
#CONFIG_USBC_PPC_DRIVER=y

# CONFIG_USB_CDC_ACM_LOG_LEVEL_OFF=y




#######################
# MCUBoot Configuration 
#######################

# CONFIG_MCUBOOT_LOG_LEVEL_WRN=y
#CONFIG_MCUBOOT_LOG_LEVEL_INF=y
CONFIG_MCUBOOT_DOWNGRADE_PREVENTION=n
CONFIG_UART_CONSOLE=y
CONFIG_CONSOLE=n
CONFIG_MCUBOOT_SERIAL=y
CONFIG_BOOT_SERIAL_UART=y

#CONFIG_MCUBOOT_GENERATE_UNSIGNED_IMAGE=y
#CONFIG_MCUBOOT_GENERATE_CONFIRMED_IMAGE=y

CONFIG_IMG_MANAGER=y
CONFIG_STREAM_FLASH=y
CONFIG_FLASH=y
CONFIG_MCUBOOT_IMG_MANAGER=y
#CONFIG_UPDATEABLE_IMAGE_NUMBER=1

CONFIG_BOOT_VALIDATE_SLOT0=y
CONFIG_BOOT_PREFER_SWAP_OFFSET=y
CONFIG_BOOT_UPGRADE_ONLY=n
CONFIG_BOOT_SWAP_USING_OFFSET=y
# CONFIG_BOOT_SWAP_USING_MOVE is not set
CONFIG_BOOT_DIRECT_XIP=n
# CONFIG_BOOT_RAM_LOAD is not set
CONFIG_BOOT_FIRMWARE_LOADER=n
# CONFIG_BOOT_BOOTSTRAP is not set
# CONFIG_SINGLE_APPLICATION_SLOT_RAM_LOAD is not set
# CONFIG_BOOT_ENCRYPT_IMAGE is not set
CONFIG_BOOT_MAX_IMG_SECTORS_AUTO=y
CONFIG_BOOT_SHARE_BACKEND_DISABLED=y
# CONFIG_BOOT_SHARE_BACKEND_EXTERNAL is not set
CONFIG_BOOT_FIH_PROFILE_OFF=y
# CONFIG_BOOT_FIH_PROFILE_LOW is not set
# CONFIG_BOOT_FIH_PROFILE_MEDIUM is not set
# CONFIG_BOOT_FIH_PROFILE_HIGH is not set
# CONFIG_BOOT_USE_BENCH is not set

CONFIG_BOOT_SERIAL_CDC_ACM=y
CONFIG_UART_CONSOLE=n

#######################
# Shell Configuration 
#######################
CONFIG_SHELL=y
CONFIG_SHELL_MINIMAL=n
CONFIG_SHELL_BACKEND_SERIAL=y
CONFIG_SHELL_BACKEND_SERIAL_INTERRUPT_DRIVEN=y
CONFIG_MCUBOOT_SHELL=y

CONFIG_SHELL_CMDS_SELECT=y
CONFIG_SHELL_START_OBSCURED=n
CONFIG_SHELL_LOG_BACKEND=n
CONFIG_SHELL_BACKEND_SERIAL_CHECK_DTR=n

# allow separate shell + console UART devices
CONFIG_SHELL_BACKEND_SERIAL=y
