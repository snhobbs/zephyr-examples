[manifest]
path = app
file = west.yml

[zephyr]
base = deps/zephyr

[build]
dir-fmt = build/{board}/
cmake-args = "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DCMAKE_VERBOSE_MAKEFILE=ON"
board = rp2350_eth/rp2350a/m33
#board = native_sim
#board = nrf52dk/nrf52805
#board = nrf52840dk/nrf52840
generator = Ninja
sysbuild = false

[update]
sync-submodules = true

[log]
verbosity=3  #  extreme

